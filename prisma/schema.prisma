generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model System {
  id                  String               @id @default(cuid())
  name                String               @unique
  url                 String
  iconName            String?
  description         String?
  // Exact callback URLs a System's backend has registered; nothing else is ever
  // redirected to. Empty until an Administrator registers the System.
  callbackUrls        String[]             @default([])
  // SHA-256 of the System backend's secret. The secret itself is shown once at
  // registration and never stored.
  backendSecretHash   String?
  accountRequests     AccountRequest[]
  modules             Module[]
  handoffCodes        HandoffCode[]
  integrationSessions IntegrationSession[]
}

model Module {
  id              String           @id @default(cuid())
  systemId        String
  name            String
  // Kept for grant history; unavailable for selection or authorization.
  retiredAt       DateTime?
  system          System           @relation(fields: [systemId], references: [id])
  accessTemplates AccessTemplate[]
  accessGrants    AccessGrant[]

  @@unique([systemId, name])
}

model Role {
  id              String           @id @default(cuid())
  name            String           @unique
  isAdministrator Boolean          @default(false)
  accessTemplates AccessTemplate[]
  users           User[]
  accountRequests AccountRequest[]
}

model AccessTemplate {
  id       String @id @default(cuid())
  roleId   String
  moduleId String
  role     Role   @relation(fields: [roleId], references: [id])
  module   Module @relation(fields: [moduleId], references: [id])

  @@unique([roleId, moduleId])
}

model User {
  id                  String               @id @default(cuid())
  username            String               @unique
  email               String               @unique
  firstName           String
  lastName            String
  roleId              String
  // Id of the matching Neon Auth user (neon_auth."user".id). Neon Auth owns the
  // credentials and sessions; this table owns everything portal-specific.
  neonAuthUserId      String               @unique
  mustChangePassword  Boolean              @default(true)
  isDeleted           Boolean              @default(false)
  deletedAt           DateTime?
  role                Role                 @relation(fields: [roleId], references: [id])
  accessGrants        AccessGrant[]        @relation("AccessGrantUser")
  accessGrantsMade    AccessGrant[]        @relation("AccessGrantGrantedBy")
  handoffCodes        HandoffCode[]
  integrationSessions IntegrationSession[]
}

model UsernameSequence {
  year       Int @id
  lastNumber Int
}

model AccessGrant {
  id            String    @id @default(cuid())
  userId        String
  moduleId      String
  grantedAt     DateTime  @default(now())
  grantedBy     String?
  revokedAt     DateTime?
  user          User      @relation("AccessGrantUser", fields: [userId], references: [id])
  module        Module    @relation(fields: [moduleId], references: [id])
  grantedByUser User?     @relation("AccessGrantGrantedBy", fields: [grantedBy], references: [id])

  @@index([userId, moduleId])
}

// Single-use sign-in code, bound to one System, one exact callback, the original
// central (Neon) session and the request's state. Only a hash of the code is stored.
model HandoffCode {
  id            String    @id @default(cuid())
  codeHash      String    @unique
  systemId      String
  userId        String
  neonSessionId String
  redirectUri   String
  state         String
  codeChallenge String
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())
  system        System    @relation(fields: [systemId], references: [id])
  user          User      @relation(fields: [userId], references: [id])

  @@index([expiresAt])
}

// Opaque System-bound handle a System backend receives for a successful exchange.
// Linked to the original central session; only a hash of the handle is stored.
model IntegrationSession {
  id            String    @id @default(cuid())
  handleHash    String    @unique
  systemId      String
  userId        String
  neonSessionId String
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  system        System    @relation(fields: [systemId], references: [id])
  user          User      @relation(fields: [userId], references: [id])

  @@index([neonSessionId])
}

enum AccountRequestStatus {
  new
  seen
  created
  declined
  cancelled
}

// HRMS owns the RQ reference; Portal owns the request's authoritative status.
model AccountRequest {
  id               String               @id @default(cuid())
  reference        String
  sourceSystemId   String
  sourceSystem     System               @relation(fields: [sourceSystemId], references: [id])
  personName       String
  workEmail        String
  personalEmail    String
  mobile           String?
  position         String
  branch           String
  startDate        DateTime             @db.Date
  roleId           String
  role             Role                 @relation(fields: [roleId], references: [id])
  moduleIds        String[]
  neededFrom       DateTime             @db.Date
  note             String?
  requesterName    String
  status           AccountRequestStatus @default(new)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  seenAt           DateTime?
  accountCreatedAt DateTime?
  declineReason    String?
  declineMessage   String?
  declinedAt       DateTime?
  cancelledAt      DateTime?
  deliveries       AccountRequestDelivery[]
  createdUserId    String?
  loginSentAt      DateTime?
  loginDeliveryToken String?
  loginDeliveryUntil DateTime?
  // SQL migration also enforces one active request per case-insensitive work email.

  @@unique([sourceSystemId, reference])
  @@index([status, createdAt])
}

// Status payloads contain no credentials. Deleted only after a 2xx acknowledgement.
model AccountRequestDelivery {
  id          String @id @default(cuid())
  requestId   String
  request     AccountRequest @relation(fields: [requestId], references: [id])
  status      String
  payload     Json
  createdAt   DateTime @default(now())

  @@unique([requestId, status])
}
