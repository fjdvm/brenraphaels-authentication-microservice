# Copy these into Vercel (Project > Settings > Environment Variables) and fill in.
# Real values never go in this file.

# --- Neon Postgres ---------------------------------------------------------
# Pooled connection string (host contains "-pooler"); used by the app at runtime.
DATABASE_URL=
# Direct (non-pooled) connection string; used by Prisma migrate and the seed script.
DIRECT_URL=

# --- Neon Auth (Managed Better Auth) ----------------------------------------
# Neon Console > project > Auth > Configuration > Auth URL.
NEON_AUTH_BASE_URL=
# At least 32 characters. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# --- App --------------------------------------------------------------------
# Public origin of this deployment, no trailing slash. It must also be listed under
# Neon Console > Auth > Configuration > Trusted domains.
NEXT_PUBLIC_APP_URL=https://br-auth-three.vercel.app

# --- Brevo SMTP -------------------------------------------------------------
# Used by this app to email a new User their Username and Temporary password.
# Password-reset emails are sent by Neon Auth itself: set the same Brevo SMTP under
# Neon Console > Auth > Settings > Email provider (it is not read from this file).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Must be a sender verified in Brevo, e.g. "Bren Raphael's <no-reply@yourdomain.com>".
EMAIL_FROM=

# --- api-gateway (notifications) --------------------------------------------
# Origin of the api-gateway, no trailing slash, and the Portal's Caller key for it.
# Server-side only: the browser never sees either. The header bell reads and marks
# notifications through the Portal's own /api/notifications routes.
API_GATEWAY_URL=https://api-gateway.jude-nitram08.workers.dev
API_GATEWAY_KEY=
# The notifications service's name for the Portal (optional, defaults to "Portal").
NOTIFICATIONS_APP=Portal

# --- audit-logs service ------------------------------------------------------
# Reached through the api-gateway's /audit prefix, no trailing slash. Server-side only.
# The gateway swaps each Caller key below for that Caller's own audit-logs key, so the
# Portal needs two Callers. (The service's origin and its own keys also work directly.)
AUDIT_LOGS_URL=https://api-gateway.jude-nitram08.workers.dev/audit
# Caller key whose audit-logs key is the write key for Source "Authentication" (records every Portal event).
AUDIT_LOGS_WRITE_KEY=
# Caller key whose audit-logs key is read:admin, used only on the server: the
# Administrator-only System logs page and its Export CSV, and every User's My Logs
# (always filtered to the signed-in User as Actor).
AUDIT_LOGS_READ_KEY=
